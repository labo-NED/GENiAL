vars = vars("age", "IQ", "SRS_restrictive_repetitive_tscore","SRS_social_communication_tscore", "SRS_social_cognition_tscore", "attention_deficit_hyperactivity_tscore"),
sd = TRUE, range = TRUE,
skew = TRUE, kurt = TRUE)
sink()
sink(NULL)
